<script>
document.addEventListener("DOMContentLoaded", function () {

    console.log("GSA LUDO: DOM READY");

    const board =
        document.getElementById("ludo-board");

    const rollButton =
        document.getElementById("roll-button");

    const dice =
        document.getElementById("dice");


    /* =====================================================
       BOARD CHECK
    ===================================================== */

    if (!board) {

        console.error(
            "GSA LUDO: #ludo-board পাওয়া যায়নি"
        );

        return;

    }


    /* =====================================================
       LUDO ENGINE CHECK
    ===================================================== */

    if (
        !window.LudoBoard ||
        typeof window.LudoBoard.create !== "function"
    ) {

        console.error(
            "GSA LUDO: ludu-board.js load হয়নি অথবা LudoBoard তৈরি হয়নি"
        );

        board.innerHTML = `
            <div style="
                min-height:100%;
                display:flex;
                align-items:center;
                justify-content:center;
                padding:30px;
                text-align:center;
                color:#fca5a5;
                font-size:14px;
                line-height:1.7;
            ">
                Ludo Board Engine Load হয়নি।
                <br>
                ludu-board.js পরীক্ষা করুন।
            </div>
        `;

        return;

    }


    /* =====================================================
       CREATE BOARD
    ===================================================== */

    try {

        window.LudoBoard.create(board);

        console.log(
            "GSA LUDO: Board successfully created"
        );

    } catch (error) {

        console.error(
            "GSA LUDO BOARD ERROR:",
            error
        );

        board.innerHTML = `
            <div style="
                min-height:100%;
                display:flex;
                align-items:center;
                justify-content:center;
                padding:30px;
                text-align:center;
                color:#fca5a5;
                font-size:14px;
                line-height:1.7;
            ">
                Board তৈরি করতে সমস্যা হয়েছে।
                <br>
                Console-এ Error দেখুন।
            </div>
        `;

    }


    /* =====================================================
       DICE
    ===================================================== */

    if (rollButton && dice) {

        rollButton.addEventListener("click", async () => {

        if (window.gsaMatch) {

            const match = window.gsaMatch;

            const currentPlayer =
                String(match.current_turn || "");

            const myPlayerId =
                localStorage.getItem("gsa_ludo_player_id") || "";

            if (
                currentPlayer &&
                myPlayerId &&
                currentPlayer !== myPlayerId
            ) {
                if (
                    typeof gsaShowStatus === "function"
                ) {
                    gsaShowStatus("Opponent-এর turn");
                }

                return;
            }

            const result =
                Math.floor(Math.random() * 6) + 1;

            dice.textContent = result;

            if (
                window.LudoBoard &&
                typeof window.LudoBoard.setDice === "function"
            ) {
                window.LudoBoard.setDice(result);
            }

            if (
                typeof gsaSaveGameState === "function"
            ) {
                await gsaSaveGameState({
                    dice: result,
                    current_turn: myPlayerId
                });
            }

            return;
        }

        const result =
            Math.floor(Math.random() * 6) + 1;

        dice.textContent = result;

        if (
            window.LudoBoard &&
            typeof window.LudoBoard.setDice === "function"
        ) {
            window.LudoBoard.setDice(result);
        }
    });

    }

});
</script>


